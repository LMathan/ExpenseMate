<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This Month"
            android:textColor="#9E9EAF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_month_spend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header_layout"
        android:layout_marginTop="4dp"
        android:text="₹0"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:fontFamily="sans-serif-condensed-light"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/split_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/text_month_spend"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <!-- Get Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢"
                android:textSize="8sp"
                android:layout_marginEnd="6dp" />
            <TextView
                android:id="@+id/text_you_get"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Get ₹0"
                android:textColor="#4CAF50"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Owe Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴"
                android:textSize="8sp"
                android:layout_marginEnd="6dp" />
            <TextView
                android:id="@+id/text_you_owe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Owe ₹0"
                android:textColor="#F44336"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>

    <!-- Optional Budget Left -->
    <TextView
        android:id="@+id/text_budget_left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:text="Left: ₹0"
        android:textColor="#FFB74D"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone" />

</RelativeLayout>
